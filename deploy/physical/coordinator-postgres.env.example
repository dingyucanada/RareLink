# RareLink physical coordinator + PostgreSQL environment TEMPLATE.
#
# Do not start the stack with this file. Copy it to a root-readable location,
# populate blank sensitive values from the hospital secret manager, set mode
# 0600, and keep the populated copy outside the repository.

# Pin reviewed images. Production should prefer immutable sha256 digests.
RARELINK_POSTGRES_IMAGE=postgres:17.6-bookworm
RARELINK_COORDINATOR_IMAGE=

# Dedicated PostgreSQL identity. The password must not be a shared account,
# product default, username, database name, or value committed to Git.
RARELINK_POSTGRES_DB=rarelink_control
RARELINK_POSTGRES_USER=rarelink_control
RARELINK_POSTGRES_PASSWORD=

# Full SQLAlchemy URL, supplied as one secret. Example shape only:
# postgresql+psycopg://USER:URL_ENCODED_PASSWORD@postgres:5432/DATABASE
# It must match the PostgreSQL values above and use the service host `postgres`.
RARELINK_DATABASE_URL=

# Pre-create these named volumes and add them to the backup/restore policy:
# docker volume create rarelink-physical-postgres
# docker volume create rarelink-physical-coordinator-artifacts
RARELINK_POSTGRES_VOLUME_NAME=rarelink-physical-postgres
RARELINK_COORDINATOR_ARTIFACT_VOLUME_NAME=rarelink-physical-coordinator-artifacts

# Bind the API to loopback when an approved HTTPS reverse proxy is on this host.
RARELINK_COORDINATOR_BIND_IP=127.0.0.1
RARELINK_COORDINATOR_PORT=9000
RARELINK_CORS_ORIGINS=https://rarelink-control.research.example.org

# Read-only provisioned NVFLARE Admin Kit directory on the coordinator host.
RARELINK_NVFLARE_ADMIN_KIT_HOST_PATH=

# Per-site HMAC mapping, for example a JSON object keyed by approved site_id.
# Values are secrets and are intentionally not shown here.
RARELINK_PHYSICAL_SITE_SECRETS=
RARELINK_AUDIT_HMAC_KEY=

# Pin one issuer/audience and an offline JWKS obtained through the hospital's
# approved trust process. Public JWKS values are not passwords, but their
# integrity is security-sensitive and populated copies remain outside Git.
RARELINK_OIDC_ISSUER=https://identity.research.example.org
RARELINK_OIDC_AUDIENCE=rarelink-physical-control
RARELINK_OIDC_JWKS_JSON=
RARELINK_OIDC_ROLES_CLAIM=rarelink_roles
RARELINK_OIDC_ORGANIZATION_CLAIM=hospital_org
RARELINK_OIDC_SITES_CLAIM=allowed_sites
