# Copy to a root-readable secret-managed environment file on ONE hospital Spark.
# Never commit populated tokens, HMAC keys, patient paths, certificates or startup kits.
RARELINK_SITE_AGENT_SITE_ID=hospital-a
RARELINK_SITE_AGENT_DATASET_MANIFEST=/srv/rarelink/site-data/manifest.json
RARELINK_SITE_AGENT_DATASET_ROOT=/srv/rarelink/site-data
RARELINK_SITE_AGENT_DATASET_RECEIPT=/var/lib/rarelink/site-agent/dataset-receipt.json
RARELINK_SITE_AGENT_REQUIRE_DATASET_RECEIPT=true
RARELINK_SITE_AGENT_ARTIFACT_ROOT=/var/lib/rarelink/artifacts
RARELINK_SITE_AGENT_STARTUP_KIT=/opt/rarelink/flare/hospital-a
RARELINK_SITE_AGENT_CERTIFICATE_FILE=/opt/rarelink/flare/hospital-a/startup/client.crt
RARELINK_SITE_AGENT_STATE_DATABASE=/var/lib/rarelink/site-agent/state.sqlite3
RARELINK_SITE_AGENT_API_TOKEN=replace-with-a-random-secret-from-hospital-kms
RARELINK_SITE_AGENT_RECEIPT_HMAC_KEY=replace-with-at-least-32-random-secret-characters
RARELINK_SITE_AGENT_BIND_HOST=127.0.0.1
RARELINK_SITE_AGENT_PORT=9100
RARELINK_SITE_AGENT_REQUIRED_FREE_MEMORY_PERCENT=15
RARELINK_SITE_AGENT_REQUIRED_FREE_DISK_PERCENT=10
RARELINK_SITE_AGENT_REQUIRED_MODULES=torch,monai,nvflare
# disabled | systemd. Enable only after hospital IT authorizes this exact unit.
RARELINK_SITE_AGENT_EXECUTOR_BACKEND=systemd
RARELINK_SITE_AGENT_NVFLARE_SERVICE_NAME=rarelink-flare-client.service
